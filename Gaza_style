/* ==============================
   SABOR DE CASA
   FEEDBACK PAGE STYLE
   ============================== */


/* ---------- GENERAL ---------- */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}


:root {

    --navy-900: #0a1a2e;
    --navy-700: #102a47;
    --navy-600: #14365e;
    --navy-500: #1c4476;
    --navy-400: #2d5a96;

    --gold-600: #b8860b;
    --gold-500: #d4a017;
    --gold-400: #e6b84d;
    --gold-300: #f0cc7a;

    --cream-50: #fefcf7;
    --cream-100: #faf6ee;
    --cream-200: #f3ecdc;
    --cream-300: #e8dcc4;

    --white: #ffffff;

    --text-dark: #0a1a2e;
    --text-muted: #4a5a6e;
}


body {

    font-family: "Plus Jakarta Sans", sans-serif;

    background: var(--cream-100);

    color: var(--text-dark);

    line-height: 1.6;
}


/* ---------- NAVIGATION ---------- */

.site-header {

    position: sticky;

    top: 0;

    z-index: 1000;

    background: var(--navy-900);

    box-shadow: 0 3px 15px rgba(0, 0, 0, 0.15);
}


.nav-bar {

    max-width: 1200px;

    margin: auto;

    min-height: 80px;

    padding: 0 30px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;
}


.nav-logo {

    text-decoration: none;

    color: white;

    display: flex;

    flex-direction: column;
}


.nav-logo span {

    font-family: "Playfair Display", serif;

    font-size: 25px;

    font-weight: 700;
}


.nav-logo small {

    color: var(--gold-300);

    font-size: 10px;

    letter-spacing: 2px;

    text-transform: uppercase;
}


.nav-links {

    list-style: none;

    display: flex;

    align-items: center;

    gap: 8px;
}


.nav-links a {

    color: white;

    text-decoration: none;

    padding: 10px 15px;

    border-radius: 5px;

    font-size: 14px;

    transition: 0.3s;
}


.nav-links a:hover,

.nav-links a.active {

    background: var(--gold-500);

    color: var(--navy-900);
}


/* ---------- HERO ---------- */

.feedback-hero {

    min-height: 390px;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    padding: 80px 20px;

    background:

        linear-gradient(
            rgba(10, 26, 46, 0.82),
            rgba(10, 26, 46, 0.82)
        ),

        url("https://images.pexels.com/photos/1640777/pexels-photo-1640777.jpeg")

        center / cover no-repeat;
}


.hero-content {

    max-width: 800px;

    color: white;
}


.eyebrow {

    color: var(--gold-300);

    font-size: 13px;

    font-weight: 700;

    letter-spacing: 4px;

    margin-bottom: 15px;
}


.feedback-hero h1 {

    font-family: "Playfair Display", serif;

    font-size: clamp(40px, 6vw, 68px);

    line-height: 1.1;

    margin-bottom: 20px;
}


.feedback-hero p:last-child {

    max-width: 600px;

    margin: auto;

    font-size: 16px;

    color: var(--cream-200);
}


/* ---------- FORM CONTAINER ---------- */

.form-container {

    width: min(1050px, 92%);

    margin: 70px auto;
}


/* ---------- FORM SECTIONS ---------- */

.form-section {

    display: grid;

    grid-template-columns: 80px 1fr;

    gap: 30px;

    background: var(--white);

    border: 1px solid var(--cream-300);

    padding: 40px;

    margin-bottom: 25px;

    border-radius: 15px;

    box-shadow: 0 5px 20px rgba(10, 26, 46, 0.06);
}


.section-number {

    width: 55px;

    height: 55px;

    display: flex;

    align-items: center;

    justify-content: center;

    background: var(--navy-900);

    color: var(--gold-300);

    border-radius: 50%;

    font-family: "Playfair Display", serif;

    font-size: 18px;

    font-weight: 700;
}


.section-content h2 {

    font-family: "Playfair Display", serif;

    color: var(--navy-900);

    font-size: 28px;

    margin-bottom: 8px;
}


.section-description {

    color: var(--text-muted);

    margin-bottom: 25px;

    font-size: 14px;
}


/* ---------- FORM GRID ---------- */

.form-grid {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 20px;
}


.form-group {

    display: flex;

    flex-direction: column;
}


.form-group label {

    font-size: 13px;

    font-weight: 700;

    margin-bottom: 8px;

    color: var(--navy-700);
}


/* ---------- INPUTS ---------- */

input[type="text"],
input[type="email"],
input[type="password"],
input[type="tel"],
input[type="number"],
input[type="date"],
select,
textarea {

    width: 100%;

    padding: 13px 15px;

    border: 1px solid var(--cream-300);

    border-radius: 8px;

    background: var(--cream-50);

    font-family: "Plus Jakarta Sans", sans-serif;

    font-size: 14px;

    color: var(--text-dark);

    outline: none;

    transition: 0.3s;
}


input:focus,
select:focus,
textarea:focus {

    border-color: var(--gold-500);

    box-shadow: 0 0 0 3px rgba(212, 160, 23, 0.15);
}


textarea {

    resize: vertical;
}


/* ---------- CHOICE CARDS ---------- */

.choice-grid {

    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 12px;
}


.choice-card {

    display: flex;

    align-items: center;

    gap: 12px;

    padding: 15px;

    border: 1px solid var(--cream-300);

    border-radius: 8px;

    background: var(--cream-50);

    cursor: pointer;

    transition: 0.3s;
}


.choice-card:hover {

    border-color: var(--gold-500);

    background: var(--gold-300);
}


.choice-card input {

    accent-color: var(--gold-600);
}


.choice-card span {

    font-size: 14px;

    font-weight: 500;
}


/* ---------- MULTIPLE SELECT ---------- */

select[multiple] {

    min-height: 150px;
}


.help-text {

    display: block;

    margin-top: 8px;

    color: var(--text-muted);

    font-size: 12px;
}


/* ---------- RATING ---------- */

.rating-box {

    padding: 25px;

    background: var(--cream-100);

    border-radius: 12px;

    text-align: center;
}


.rating-number {

    font-family: "Playfair Display", serif;

    color: var(--navy-900);

    font-size: 45px;

    font-weight: 700;

    margin-bottom: 20px;
}


.rating-number small {

    font-size: 18px;

    color: var(--text-muted);
}


input[type="range"] {

    width: 100%;

    accent-color: var(--gold-500);

    cursor: pointer;
}


.range-labels {

    display: flex;

    justify-content: space-between;

    margin-top: 10px;

    color: var(--text-muted);

    font-size: 12px;
}


/* ---------- COLOR ---------- */

.color-picker {

    display: flex;

    align-items: center;

    gap: 15px;
}


input[type="color"] {

    width: 70px;

    height: 55px;

    border: 2px solid var(--cream-300);

    border-radius: 8px;

    padding: 4px;

    background: white;

    cursor: pointer;
}


.color-picker label {

    color: var(--text-muted);

    font-size: 14px;
}


/* ---------- FILE UPLOAD ---------- */

input[type="file"] {

    width: 100%;

    padding: 18px;

    border: 2px dashed var(--cream-300);

    border-radius: 10px;

    background: var(--cream-50);

    font-family: "Plus Jakarta Sans", sans-serif;

    cursor: pointer;
}


/* ---------- PROGRESS ---------- */

progress {

    width: 100%;

    height: 18px;

    appearance: none;

    border: none;

    border-radius: 20px;

    overflow: hidden;
}


progress::-webkit-progress-bar {

    background: var(--cream-200);

    border-radius: 20px;
}


progress::-webkit-progress-value {

    background: var(--gold-500);

    border-radius: 20px;
}


progress::-moz-progress-bar {

    background: var(--gold-500);

    border-radius: 20px;
}


.progress-text {

    margin-top: 8px;

    text-align: center;

    color: var(--text-muted);

    font-size: 13px;
}


/* ---------- BUTTONS ---------- */

.form-buttons {

    display: flex;

    flex-wrap: wrap;

    gap: 12px;
}


.btn {

    display: inline-block;

    padding: 13px 22px;

    border-radius: 7px;

    font-family: "Plus Jakarta Sans", sans-serif;

    font-size: 14px;

    font-weight: 700;

    text-decoration: none;

    cursor: pointer;

    transition: 0.3s;
}


.btn.primary {

    border: 2px solid var(--navy-900);

    background: var(--navy-900);

    color: white;
}


.btn.primary:hover {

    background: var(--navy-700);
}


.btn.secondary {

    border: 2px solid var(--cream-300);

    background: var(--cream-100);

    color: var(--navy-900);
}


.btn.secondary:hover {

    background: var(--cream-200);
}


.btn.outline {

    border: 2px solid var(--gold-500);

    background: transparent;

    color: var(--gold-600);
}


.btn.outline:hover {

    background: var(--gold-500);

    color: white;
}


/* ---------- FOOTER ---------- */

.site-footer {

    background: var(--navy-900);

    color: white;

    padding: 50px 30px 25px;
}


.footer-content {

    max-width: 1100px;

    margin: auto;

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 30px;
}


.footer-content h3 {

    font-family: "Playfair Display", serif;

    font-size: 25px;
}


.footer-content p {

    color: var(--gold-300);

    font-size: 13px;
}


.footer-links {

    display: flex;

    flex-wrap: wrap;

    gap: 18px;
}


.footer-links a {

    color: white;

    text-decoration: none;

    font-size: 13px;
}


.footer-links a:hover {

    color: var(--gold-300);
}


.copyright {

    max-width: 1100px;

    margin: 35px auto 0;

    padding-top: 20px;

    border-top: 1px solid rgba(255, 255, 255, 0.15);

    text-align: center;

    color: #b8c4d0;
}


/* ---------- MOBILE ---------- */

@media (max-width: 800px) {

    .nav-bar {

        flex-direction: column;

        padding: 18px;
    }


    .nav-links {

        flex-wrap: wrap;

        justify-content: center;
    }


    .feedback-hero {

        min-height: 330px;
    }


    .form-section {

        grid-template-columns: 1fr;

        gap: 20px;

        padding: 25px;
    }


    .form-grid {

        grid-template-columns: 1fr;
    }


    .choice-grid {

        grid-template-columns: 1fr;
    }


    .footer-content {

        flex-direction: column;

        text-align: center;
    }


    .footer-links {

        justify-content: center;
    }

}


@media (max-width: 500px) {

    .feedback-hero h1 {

        font-size: 40px;
    }


    .form-container {

        width: 94%;

        margin: 40px auto;
    }


    .form-section {

        padding: 20px;
    }


    .form-buttons {

        flex-direction: column;
    }


    .btn {

        width: 100%;

        text-align: center;
    }

}